# ===== 应用配置 =====
APP_NAME=rag-knowledge-base
LOG_LEVEL=INFO
# ===== PostgreSQL（docker-compose 与后端共用）=====
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag_kb
POSTGRES_PORT=5432

# 后端连接串：注意使用 asyncpg driver
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag_kb

# .env.example
COS_SECRET_ID=your_secret_id_here
COS_SECRET_KEY=your_secret_key_here
COS_REGION=ap-nanjing
COS_BUCKET=your_bucket_name
